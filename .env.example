# On Hostinger, copy this file as .env or edit app/Config/config.php

APP_ENV=production
APP_DEBUG=false
APP_URL=https://akasheventmanagementhosur.in

# Hostinger Database Credentials (from hPanel -> Databases -> MySQL Databases)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_akash
DB_USER=u123456789_akash
DB_PASS=YourHostingerDatabasePasswordHere
